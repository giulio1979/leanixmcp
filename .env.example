# LeanIX MCP Server Configuration

# LeanIX API Connection
LEANIX_BASE_URL=https://app.leanix.net
LEANIX_WORKSPACE_ID=your-workspace-id

# Authentication — provide EITHER api_token OR client_id + client_secret
LEANIX_API_TOKEN=your-api-token
# LEANIX_CLIENT_ID=your-client-id
# LEANIX_CLIENT_SECRET=your-client-secret

# MCP Server
MCP_PORT=3000
MCP_AUTH_PORT=3001

# OAuth — set to "false" to disable MCP-level OAuth (all requests allowed)
MCP_OAUTH_ENABLED=true
