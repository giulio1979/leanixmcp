{
  "name": "leanix-mcp-tiny-server",
  "version": "1.0.0",
  "description": "LeanIX MCP Tiny Server with OAuth support - Streamable HTTP and stdio transports",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "leanix-mcp-tiny-server": "dist/stdio.js",
    "leanix-mcp-tiny-http": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["mcp", "leanix", "enterprise-architecture", "graphql", "oauth"],
  "license": "MIT"
}
